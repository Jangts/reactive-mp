{
  "name": "@reactive-mp/wechat",
  "version": "0.1.0",
  "type": "module",
  "description": "Result-based native WeChat API wrappers and configurable request clients",
  "keywords": [
    "wechat",
    "miniprogram",
    "request",
    "router",
    "storage"
  ],
  "main": "./src/index.js",
  "types": "./index.d.ts",
  "miniprogram": "src",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./src/index.js"
    },
    "./wx": {
      "types": "./wx.d.ts",
      "default": "./src/wx/index.js"
    },
    "./network": {
      "types": "./network.d.ts",
      "default": "./src/network/index.js"
    }
  },
  "files": [
    "src",
    "*.d.ts",
    "README.md",
    "docs"
  ],
  "license": "ISC",
  "dependencies": {},
  "reactiveMp": {
    "release": {
      "type": "public"
    },
    "docs": "./docs/site.json"
  },
  "scripts": {
    "docs:build": "node ../../apps/docs/build.mjs --package @reactive-mp/wechat",
    "docs:dev": "node ../../apps/docs/serve.mjs --package @reactive-mp/wechat"
  }
}
