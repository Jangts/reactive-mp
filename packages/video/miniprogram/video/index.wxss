.c-video-container {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
}

.c-video,
.c-video-poster,
.c-video-poster image {
  position: absolute;
  left: 0;
  top: 0;
  display: block;
  width: 100%;
  height: 100%;
}

.c-video-poster {
  pointer-events: none;
}

.c-sound,
.c-play {
  position: absolute;
  color: var(--video-control-color, white);
  font-size: var(--video-control-font-size, 14px);
}

.c-sound {
  right: var(--video-control-inset, 16px);
  bottom: var(--video-control-inset, 16px);
}

.c-play {
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
}

.c-sound-image,
.c-play-image {
  padding: var(--video-control-padding, 8px);
}

.c-sound-image + .c-sound-image {
  position: absolute;
  left: 0;
  top: 0;
}

.bootom-progress {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  background: var(--video-progress-track-color, rgba(255, 255, 255, 0.1));
}

.bootom-progress-line {
  height: var(--video-progress-height, 2px);
  background: var(--video-progress-color, white);
}

.custom-progress-inner-rect {
  position: absolute;
  left: 0;
  bottom: 0;
  height: var(--video-progress-touch-height, 24px);
  width: 100%;
}
