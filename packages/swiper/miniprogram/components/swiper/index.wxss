.swiper-shell { position: relative; width: 100%; height: 100%; display: flex; flex-direction: column; }
.viewport { width: 100%; height: 0; flex: 1; min-height: 0; }
.item-frame, .item-space, .item-transform { width: 100%; height: 100%; box-sizing: border-box; }
.item-space { padding-left: calc(var(--swiper-gap, 0px) / 2); padding-right: calc(var(--swiper-gap, 0px) / 2); transform-origin: var(--swiper-origin, center); transform: perspective(800px) rotateY(var(--swiper-rotate, 0deg)); }
.item-transform { transform-origin: center; transform: translateX(var(--swiper-shift, 0%)) scale(var(--swiper-scale, 1)); }
.indicator { display: flex; justify-content: center; gap: 8px; padding: 8px 0; }
.dot { width: 16px; height: 2px; background: var(--swiper-indicator-color, currentColor); opacity: 0.3; }
.dot.active { opacity: 1; }
