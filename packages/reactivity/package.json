{
  "name": "@reactive-mp/reactivity",
  "version": "1.0.0",
  "type": "module",
  "main": "./src/index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./src/index.js"
    },
    "./signal": {
      "types": "./signal.d.ts",
      "default": "./src/signal.js"
    },
    "./EffectScope": {
      "types": "./effect-scope.d.ts",
      "default": "./src/EffectScope.js"
    },
    "./signal-carriers/carriers": {
      "types": "./carriers.d.ts",
      "default": "./src/signal-carriers/carriers.js"
    }
  },
  "files": [
    "src/**/*.js",
    "index.d.ts",
    "README.md",
    "signal.d.ts",
    "effect-scope.d.ts",
    "carriers.d.ts",
    "docs"
  ],
  "license": "ISC",
  "dependencies": {
    "@reactive-mp/shared": "1.0.0"
  },
  "description": "Standalone signals, computed values, reactive objects and effect scopes",
  "keywords": [
    "signals",
    "reactivity",
    "computed",
    "watch",
    "javascript"
  ],
  "reactiveMp": {
    "release": {
      "type": "public"
    },
    "docs": "./docs/site.json"
  },
  "scripts": {
    "docs:build": "node ../../apps/docs/build.mjs --package @reactive-mp/reactivity",
    "docs:dev": "node ../../apps/docs/serve.mjs --package @reactive-mp/reactivity"
  }
}
