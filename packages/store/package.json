{
  "name": "@reactive-mp/store",
  "version": "1.0.0",
  "type": "module",
  "main": "./src/index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./src/index.js"
    }
  },
  "files": [
    "src/**/*.js",
    "index.d.ts",
    "README.md",
    "docs"
  ],
  "license": "ISC",
  "dependencies": {
    "@reactive-mp/reactivity": "1.0.0",
    "@reactive-mp/shared": "1.0.0"
  },
  "description": "Lazy shared stores with independent effect scopes for Reactive MP",
  "keywords": [
    "state-management",
    "store",
    "signals",
    "javascript"
  ],
  "reactiveMp": {
    "release": {
      "type": "public"
    },
    "docs": "./docs/site.json"
  },
  "scripts": {
    "docs:build": "node ../../apps/docs/build.mjs --package @reactive-mp/store",
    "docs:dev": "node ../../apps/docs/serve.mjs --package @reactive-mp/store"
  },
  "homepage": "https://reactive-mp-store-docs.pages.jangts.cafe/"
}
