/* 表单的结构与可覆盖外观；反馈参与文档流，不依赖宿主字体或图标。 */
.form,
.form-item,
.control {
  box-sizing: border-box;
  width: 100%;
  color: var(--form-color, #222);
  font-size: var(--form-font-size, 28rpx);
}
.form-item {
  display: flex;
  flex-direction: column;
  gap: var(--form-gap, 12rpx);
  margin-bottom: var(--form-item-gap, 28rpx);
}
.form-item.left {
  flex-direction: row;
  align-items: flex-start;
}
.left .item-label {
  width: var(--form-label-width, 160rpx);
  flex-shrink: 0;
}
.item-content {
  flex: 1;
  min-width: 0;
}
.item-label {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}
.label-extra {
  margin-left: auto;
}
.required,
.error {
  color: var(--form-error-color, #c63535);
}
.item-field {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.item-field-content {
  flex: 1;
}
.help,
.error,
.count {
  font-size: var(--form-help-size, 24rpx);
  line-height: 1.5;
  margin-top: 8rpx;
  overflow-wrap: anywhere;
}
.help,
.count {
  color: var(--form-muted-color, #888);
}
.count {
  text-align: right;
}
.control {
  min-height: 72rpx;
  padding: var(--form-control-padding, 16rpx 0);
}
.control.outline {
  border: 1px solid var(--form-border-color, #ccc);
  border-radius: var(--form-radius, 8rpx);
  padding: 16rpx 20rpx;
}
.control.underline {
  border-bottom: 1px solid var(--form-border-color, #ccc);
}
.text-field {
  width: 100%;
  min-height: 44rpx;
}
.disabled {
  opacity: 0.45;
}
.choice-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 12rpx 0;
}
.checkbox-mark {
  width: 34rpx;
  height: 34rpx;
  border: 1px solid var(--form-border-color, #aaa);
  display: flex;
  align-items: center;
  justify-content: center;
}
.checked,
.selected {
  color: var(--form-accent, #286f86);
}
.switch-mark {
  width: 72rpx;
  height: 40rpx;
  background: #aaa;
  border-radius: 24rpx;
  position: relative;
}
.switch-mark::after {
  content: '';
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  width: 32rpx;
  height: 32rpx;
  background: white;
  border-radius: 50%;
  transition: left 0.15s;
}
.switch-mark.checked {
  background: var(--form-accent, #286f86);
}
.switch-mark.checked::after {
  left: 36rpx;
}
.choice-options.buttons {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.choice-option {
  padding: 20rpx 12rpx;
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
}
.buttons .choice-option {
  border: 1px solid var(--form-border-color, #ddd);
  border-radius: var(--form-radius, 8rpx);
}
.choice-tick {
  margin-right: 8rpx;
}
.expand {
  text-align: center;
  padding: 12rpx;
  color: var(--form-accent, #286f86);
}
.popup-mask {
  position: fixed;
  inset: 0;
  background: #0006;
  display: flex;
  align-items: flex-end;
  z-index: 1000;
}
.popup {
  background: var(--form-surface, #fff);
  width: 100%;
  padding: 28rpx;
  box-sizing: border-box;
  border-radius: 24rpx 24rpx 0 0;
  padding-bottom: calc(28rpx + env(safe-area-inset-bottom));
}
.popup-header {
  text-align: center;
  font-weight: 600;
  padding-bottom: 24rpx;
}
.popup-options {
  max-height: 55vh;
}
.popup-actions {
  display: flex;
  gap: 16rpx;
}
.popup-actions .action-button {
  flex: 1;
}
.calendar-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.calendar-header .calendar-nav {
  margin: 0;
}
.calendar-grid {
  display: flex;
  flex-wrap: wrap;
}
.calendar-day {
  width: 14.285%;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.calendar-day.selected {
  background: var(--form-accent, #286f86);
  color: white;
  border-radius: 8rpx;
}
.upload-list {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}
.upload-file,
.upload-add {
  width: var(--form-upload-size, 160rpx);
  min-height: 160rpx;
}
.upload-image {
  width: 100%;
  height: 160rpx;
}
.upload-add,
.video-preview {
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 160rpx;
  background: var(--form-fill, #f3f3f3);
}
.upload.single .upload-file,
.upload.single .upload-add {
  width: var(--form-single-upload-size, 240rpx);
}
.form-button {
  background: var(--form-accent, #286f86);
  color: #fff;
  border-radius: var(--form-radius, 8rpx);
}

:host {
  display: block;
  width: 100%;
  min-width: 0;
}
