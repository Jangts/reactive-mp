<view class="control {{appearance}} {{fieldDisabled ? 'disabled' : ''}} custom-class"><view wx:if="{{presentation === 'popup'}}" bindtap="open">{{display || placeholder}}</view><picker wx:else range="{{pickerRange}}" value="{{pickerValue}}" disabled="{{fieldDisabled || fieldReadonly}}" bindchange="onPickerChange" bindcancel="onPickerCancel"><view>{{display || placeholder}}</view></picker><slot name="summary"/></view><view wx:if="{{opened}}" class="popup-mask" catchtouchmove="noop" catchtap="close"><view class="popup" catchtap="noop"><view class="popup-header">{{title || placeholder}}</view><scroll-view scroll-y class="popup-options"><view wx:for="{{popupOptions}}" wx:key="index" data-index="{{item.index}}" bindtap="onDraft" class="choice-option {{item.checked ? 'selected' : ''}} {{item.disabled ? 'disabled' : ''}}">{{item.label}}<text>{{item.checked ? '✓' : ''}}</text></view></scroll-view><view class="popup-actions"><button class="action-button" bindtap="close">取消</button><button class="action-button" bindtap="confirm">确定</button></view></view></view>
