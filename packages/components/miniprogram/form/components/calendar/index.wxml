<view class="calendar custom-class"><view class="calendar-header"><button class="calendar-nav" bindtap="previousMonth">‹</button><text>{{calendarMonth}}</text><button class="calendar-nav" bindtap="nextMonth">›</button></view><view class="calendar-grid"><text wx:for="{{weekdays}}" wx:key="index" class="calendar-day">{{item}}</text><view wx:for="{{days}}" wx:key="index" data-index="{{index}}" bindtap="onDay" class="calendar-day {{item.selected ? 'selected' : ''}} {{item.disabled ? 'disabled' : ''}}">{{item.day}}</view></view></view>
