<view class="control {{appearance}} custom-class" bindtap="open">{{display || placeholder}}</view><view wx:if="{{opened}}" class="popup-mask" catchtouchmove="noop" catchtap="close"><view class="popup" catchtap="noop"><view class="cascade-levels"><text wx:for="{{levels}}" wx:key="index" data-index="{{index}}" bindtap="onLevel">{{item}} / </text></view><view wx:if="{{loading}}" class="help">加载中</view><scroll-view scroll-y class="popup-options"><view wx:for="{{cascadeOptions}}" wx:key="index" data-index="{{index}}" class="choice-option {{item.disabled ? 'disabled' : ''}}" bindtap="onCascadeChoose">{{item.label}}</view></scroll-view><button bindtap="close">取消</button></view></view>
