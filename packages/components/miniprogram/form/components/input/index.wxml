<view class="control {{appearance}} {{fieldDisabled ? 'disabled' : ''}} custom-class"><input class="text-field" value="{{fieldValue}}" type="{{type}}" password="{{password}}" maxlength="{{-1}}" disabled="{{fieldDisabled || fieldReadonly}}" placeholder="{{placeholder}}" focus="{{focus}}" auto-height="{{autoHeight}}" adjust-position="{{adjustPosition}}" confirm-type="{{confirmType}}" bindinput="onInput" bindfocus="onFocus" bindblur="onBlur" bindconfirm="onConfirm"/>
 <view wx:if="{{showCount}}" class="count">{{count}}<text wx:if="{{maxlength >= 0}}">/{{maxlength}}</text></view></view>
