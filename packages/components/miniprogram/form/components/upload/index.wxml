<view class="upload {{variant}} custom-class"><view wx:if="{{title}}">{{title}}</view><view class="help">{{description}}</view><view class="upload-list"><view wx:for="{{files}}" wx:key="id" class="upload-file"><view data-id="{{item.id}}" bindtap="onPreview"><image class="upload-image" wx:if="{{item.type === 'image'}}" src="{{item.tempFilePath || item.url}}" mode="aspectFill"/><view wx:else class="video-preview">▶ 视频</view></view><text wx:if="{{item.status === 'uploading'}}">{{item.progress}}%</text><view wx:if="{{item.status === 'error'}}" data-id="{{item.id}}" bindtap="onRetry" class="error">重试</view><view wx:if="{{!fieldDisabled && !fieldReadonly}}" data-id="{{item.id}}" bindtap="onRemove">删除</view></view><view wx:if="{{!fieldDisabled && !fieldReadonly && files.length < maxCount}}" class="upload-add" bindtap="choose">＋<slot name="add"/></view></view></view>
