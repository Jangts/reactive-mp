<view class="choice-options {{variant}} {{fieldDisabled ? 'disabled' : ''}} custom-class"><view wx:for="{{visibleChoices}}" wx:key="index" data-index="{{item.index}}" bindtap="onChoose" class="choice-option {{item.checked ? 'selected' : ''}} {{item.disabled ? 'disabled' : ''}}"><text class="choice-tick">{{item.checked ? '✓' : '○'}}</text>{{item.label}}</view></view><view wx:if="{{canExpand}}" class="expand" bindtap="toggleExpanded">{{expanded ? '收起' : '更多'}}</view>
