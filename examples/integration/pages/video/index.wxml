<view class="page">
  <view class="title">Video 使用示例</view>
  <view class="hint">四种接入方式分别运行。三段动效带时间读数和不同配乐，便于检查播放和声音切换。</view>
  <view class="section" wx:for="{{scenarios}}" wx:key="path">
    <button data-path="{{item.path}}" bindtap="openScenario">{{item.title}}</button>
    <view class="hint">{{item.detail}}</view>
  </view>
</view>
