<view class="page">
  <view class="title">1. 传统 Page + rmp video</view>
  <view class="player" wx:if="{{visible}}">
    <rmp-video id="player" src="{{src}}" poster="{{poster}}" paused="{{paused}}"
      loop="{{false}}" show-custom-play-btn show-custom-progress enable-progress-touch
      bind:play="onVideoEvent" bind:pause="onVideoEvent" bind:error="onVideoEvent"
      bind:playbacksummary="onPlaybackSummary" />
  </view>
  <view class="actions">
  <button size="mini" data-action="play" bindtap="controlVideo">播放</button>
  <button size="mini" data-action="pause" bindtap="controlVideo">暂停</button>
  <button size="mini" data-action="stop" bindtap="controlVideo">停止</button>
  <button size="mini" bindtap="togglePaused">{{paused ? '解除外部暂停' : '外部暂停'}}</button>
  <button size="mini" bindtap="toggleVisible">{{visible ? '卸载组件' : '挂载组件'}}</button>
</view>
  <view class="hint">分别使用播放、暂停、停止和外部暂停；播放结束或卸载后查看汇总。</view>
  <include src="../video/events.wxml" />
</view>
