.page {
  padding: 32rpx;
}
.title {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 24rpx;
}
.hint {
  font-size: 25rpx;
  color: #555;
  margin: 20rpx 0;
  line-height: 1.6;
}
.gallery {
  height: 400rpx;
  margin: 24rpx 0;
}
.actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: 20rpx 0;
}
.actions button {
  margin: 0;
}
.section {
  margin-top: 28rpx;
}
.event {
  font-size: 22rpx;
  line-height: 1.5;
  padding: 16rpx;
  margin-top: 12rpx;
  background: #f4f5f7;
  word-break: break-all;
}
.native-card {
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}
