<view class="intro">直接使用原生 input。输入至少三个字符，并让确认内容一致。</view><input value="{{password}}" placeholder="输入内容" bindinput="onPasswordInput" bindblur="onPasswordBlur"/><view>{{passwordError}}</view><input value="{{confirmation}}" placeholder="确认内容" bindinput="onConfirmationInput" bindblur="onConfirmationBlur"/><view>{{confirmationError}}</view><button bindtap="add">添加重复行</button><view wx:for="{{rows}}" wx:key="key">{{item.key}} / {{item.value.text}}<button data-index="{{index}}" bindtap="remove">删除这一行</button></view><button bindtap="move">首行移到末尾</button><button bindtap="submit">提交</button><button bindtap="reset">重置</button><view class="result">{{result}}</view><view>valid={{meta.valid}} / status={{meta.status}}</view>